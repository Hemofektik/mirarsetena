# Mirar Setena — local environment template (copy to .env, never commit .env)

# Storage root for the two-level cache:
#   level 1 — scene AOI-window source data (kept, re-renderable from source)
#   level 2 — rendered tiles (LRU budget: project config cache.tile_budget_bytes)
MIRAR_STORAGE_ROOT=./data/cache

# Copernicus CDSE credentials — coherence layer only (SCOPE R4-Q1).
# Core layers (Sentinel-2 optical, Sentinel-1 backscatter) work without these.
# CDSE_CLIENT_ID=
# CDSE_CLIENT_SECRET=
